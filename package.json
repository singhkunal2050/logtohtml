{
  "name": "logtohtml",
  "repository": {
    "type": "git",
    "url": "https://github.com/singhkunal2050/logtohtml.git"
  },
  "version": "0.1.6",
  "description": "A lightweight JavaScript utility that adds a dynamic log window to your application, beautifies console outputs, and enhances debugging on mobile interfaces.",
  "main": "index.js",
  "scripts": {
    "prepare": "npm run build",
    "test": "vitest run",
    "build": "webpack --mode production",
    "watch": "nodemon --watch src --ext js,jsx,css,html --exec 'npm run build'"
  },
  "keywords": [
    "console",
    "debugging",
    "log",
    "mobile-debugging",
    "javascript"
  ],
  "author": "@singhkunal2050",
  "license": "ISC",
  "dependencies": {
    "react": "npm:@preact/compat",
    "react-dom": "npm:@preact/compat"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.25.9",
    "@babel/preset-env": "^7.26.9",
    "babel-loader": "^9.2.1",
    "css-loader": "^7.1.2",
    "jsdom": "^30.1.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "vitest": "^5.0.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}
